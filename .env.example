# Turso; omit locally to use file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# HMAC secret shared only by the deployment and local Codex collector
CODEX_SYNC_SECRET=

# Optional GitHub contributions heatmap.
# Fine-grained token, no repository access, no account permissions — the
# contributions calendar is public data and needs no scopes at all.
GITHUB_TOKEN=

# Optional now-playing card
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
